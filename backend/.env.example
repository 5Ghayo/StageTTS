# StageTTS 主后端环境变量示例（复制为 backend/.env 后按本机路径修改）

# 目录配置（留空则默认使用仓库根目录下的 workspace/ 与 assets/）
WORKSPACE_DIR=
ASSETS_DIR=

# GPT-SoVITS 根目录与轻量 v2 CUDA 配置文件（启用按需启停时必填）
GPT_SOVITS_ROOT=C:/Project/GPT-SoVITS-v5-20261006nvidia50x0
GPT_SOVITS_CONFIG=backend/tts_v2.yaml
# 显存串行接力开关：1 = 轮到合成时自动拉起 GPT-SoVITS，轮到解析前自动关闭释放 100% 显存
TTS_AUTO_MANAGE=1
TTS_STARTUP_TIMEOUT_SEC=90

# 解析子进程 env_parse 的 Python 可执行文件路径（建议安装到非 C 盘目录）
ENV_PARSE_PYTHON=F:/Download/StageTTS/env_parse/python.exe
HF_HOME=F:/Download/StageTTS/hf_cache
HUGGINGFACE_HUB_CACHE=F:/Download/StageTTS/hf_cache/hub
TORCH_HOME=F:/Download/StageTTS/torch_cache
PIP_CACHE_DIR=F:/Download/StageTTS/pip_cache

# WhisperX 模型与推理精度（RTX 5060 8GB 推荐 small/medium + int8，支持 OOM 自动降级）
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# GPT-SoVITS api_v2.py 推理服务地址
TTS_API_URL=http://127.0.0.1:9880

# 超时控制（秒）
TTS_TIMEOUT_SEC=120
PARSE_TIMEOUT_SEC=1800
LLM_TIMEOUT_SEC=60

# 大模型 API 配置（兼容 OpenAI SDK 格式：本地网关 / DeepSeek / Qwen 等）
# 本地网关示例：
# LLM_BASE_URL=http://127.0.0.1:3425/v1
# LLM_MODEL=workbuddy-ai/hy4flash-free
LLM_API_KEY=local-gateway-no-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# HuggingFace Token（用于 pyannote/speaker-diarization-3.1 说话人聚类鉴权）
HF_TOKEN=hf_your_token_here
